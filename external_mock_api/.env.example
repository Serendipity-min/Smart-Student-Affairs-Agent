# =============================================================================
# 学事智办 · External Mock API 环境变量示例
# =============================================================================

# 服务监听端口与地址 (默认 3000 / 127.0.0.1)
PORT=3000
HOST=127.0.0.1

# Bearer 鉴权 Token (必须与 Gateway 配置一致，长度至少 32 字符)
DEMO_API_TOKEN=replace-with-at-least-32-random-characters

# 数据状态文件存储路径 (默认本地 JSON 状态持久化)
DEMO_DATA_FILE=./data/state.json
