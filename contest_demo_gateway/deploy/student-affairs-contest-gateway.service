[Unit]
Description=学事智办比赛演示 Gateway
After=network-online.target student-affairs-api.service
Wants=network-online.target

[Service]
Type=simple
User=studentaffairsdemo
Group=studentaffairsdemo
WorkingDirectory=/opt/student-affairs-contest-demo/current/gateway
EnvironmentFile=/etc/student-affairs-contest-demo/gateway.env
ExecStart=/usr/bin/node /opt/student-affairs-contest-demo/current/gateway/src/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
