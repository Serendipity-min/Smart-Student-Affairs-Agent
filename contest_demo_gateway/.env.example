# =============================================================================
# 学事智办 · Contest Demo Gateway 环境变量示例
# =============================================================================

# Gateway 服务监听端口与地址 (默认 8787 / 127.0.0.1)
PORT=8787
HOST=127.0.0.1

# FastGPT 平台基础地址 (必须为仅服务端可见，严禁暴露至浏览器)
FASTGPT_BASE=https://example.invalid

# 主路由 Agent 配置 (占位符，请替换为您的实际凭证)
FASTGPT_MAIN_APP_ID=replace-with-main-app-id
FASTGPT_MAIN_API_KEY=replace-with-main-api-key

# T01 制度问答 Agent
FASTGPT_T01_APP_ID=replace-with-t01-app-id
FASTGPT_T01_API_KEY=replace-with-t01-api-key

# T02 请假办理 Agent
FASTGPT_T02_APP_ID=replace-with-t02-app-id
FASTGPT_T02_API_KEY=replace-with-t02-api-key

# T03 状态查询 Agent
FASTGPT_T03_APP_ID=replace-with-t03-app-id
FASTGPT_T03_API_KEY=replace-with-t03-api-key

# 后端 DEMO API 地址与鉴权 Token (必须与 external_mock_api 配置一致，长度至少 32 字符)
DEMO_API_BASE=http://127.0.0.1:3000
DEMO_API_TOKEN=replace-with-at-least-32-random-characters
